# ─── CPU ─────────────────────────────────────────────────────────────────────────────
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ─── Flash & PSRAM ───────────────────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# ─── Bluetooth (NimBLE stack — lighter than Bluedroid) ───────────────────────
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Capacità connessioni: 1 peripheral (telefono) + 4 central (power/CSC/HR/ruota)
# = 5, +2 di margine per overlap di riconnessione / secondo viewer. Il controller
# regge fino a CONFIG_BT_CTRL_BLE_MAX_ACT=10 (conn+adv+scan), quindi 7 è entro i limiti.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=7
# CCCD: il telefono può sottoscrivere fino a 8 caratteristiche notify; 16 dà
# margine (incluse le sottoscrizioni persistite sui bond).
CONFIG_BT_NIMBLE_MAX_CCCDS=16
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# §2.G v0.3.4: LE Secure Connections per il confine G cifrato+bondato (Level>=2).
# Gia' =y nel sdkconfig generato (SECURITY_ENABLE/SM_SC/SM_LEGACY/NVS_PERSIST);
# esplicitati qui per riproducibilita' in caso di rigenerazione pulita.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185

# ─── WiFi ─────────────────────────────────────────────────────────────────────────────
# esp_wifi_init/start richiesti da wifi_coach.h

# ─── FreeRTOS ─────────────────────────────────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=n

# ─── Logging ─────────────────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ─── NVS ─────────────────────────────────────────────────────────────────────────────
CONFIG_NVS_ENCRYPTION=n

# ─── Power management ────────────────────────────────────────────────────────────────
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y

# ─── I2C ─────────────────────────────────────────────────────────────────────────────
CONFIG_I2C_ISR_IRAM_SAFE=y

# ─── UART ─────────────────────────────────────────────────────────────────────────────
CONFIG_UART_ISR_IN_IRAM=y

# ─── SPI (for display) ───────────────────────────────────────────────────────────────
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# ─── Partition table ───────────────────────────────────────────────────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ─── PSRAM ─────────────────────────────────────────────────────────────────────────────
CONFIG_SPIRAM_SIZE=2097152
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# ─── OTA firmware update ───────────────────────────────────────────────────────────────
CONFIG_OTA_ALLOW_HTTP=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Controller BLE: 10 attività (4 connessioni + adv + scan, con margine)
CONFIG_BT_CTRL_BLE_MAX_ACT=10
