/*
 * AeroDrag Wheel — devicetree overlay (TEMPLATE, da adattare alla board reale).
 * ICM-42688-P collegato via SPI. Pin/SPI da verificare sulla scheda definitiva.
 * Esempio per nRF52840 (spi1). Aggiusta cs-gpios e i pin secondo l'HW.
 */

&pinctrl {
	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 14)>,
				<NRF_PSEL(SPIM_MISO, 1, 15)>;
		};
	};
	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 14)>,
				<NRF_PSEL(SPIM_MISO, 1, 15)>;
			low-power-enable;
		};
	};
};

&spi1 {
	status = "okay";
	cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";

	icm42688: icm42688@0 {
		compatible = "invensense,icm42688";
		reg = <0>;
		spi-max-frequency = <8000000>;
		/* int-gpios opzionale: data-ready su un GPIO se cablato */
	};
};

/ {
	aliases {
		imu = &icm42688;
	};
};
